{
    "name": "kumogire/laravel-workflow",
    "description": "A flexible workflow system for Laravel applications",
    "keywords": ["laravel", "workflow", "state-machine", "process"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Keith Anderson",
            "email": "kumogire@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3",
        "laravel/framework": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "laravel/sanctum": "^4.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "autoload": {
        "psr-4": {
            "Kumogire\\Workflow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kumogire\\Workflow\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kumogire\\Workflow\\WorkflowServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
